# Copy to .env. Never commit secrets.
PORT=8787
# Official public faucet. Leave unset for the default upstream;
# set to empty or "mock" to run in MOCK mode (no real payouts).
UPSTREAM_FAUCET_URL=https://testnet.stellereum.org/api/faucet-public
# Optional bearer token, if the upstream requires one for POST /<address>.
UPSTREAM_FAUCET_TOKEN=
# Trust a fronting proxy hop so req.ip is the real client (e.g. 1 or "loopback").
TRUST_PROXY=
ADDR_WINDOW_MS=2700000
IP_WINDOW_MS=600000
CORS_ORIGIN=http://localhost:5174
