[Unit]
Description=Stellereum Indexer API & Syncer
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/stellereum-indexer
EnvironmentFile=/root/stellereum-indexer/env.indexer
ExecStart=/root/stellereum-indexer/stellereum-indexer
Restart=always
RestartSec=5
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stellereum-indexer

# Sandboxing & privilege hardening (defense-in-depth):
# Prevent the indexer or any child process from gaining new privileges via setuid/filecaps.
NoNewPrivileges=yes
# Isolate /tmp and /var/tmp in a private mount namespace.
PrivateTmp=yes
# Mount the OS hierarchy read-only except explicit ReadWritePaths below.
ProtectSystem=strict
# Keep /home and /root read-only; only the indexer's state directory is writable.
ProtectHome=read-only
ReadWritePaths=/root/stellereum-indexer

[Install]
WantedBy=multi-user.target
