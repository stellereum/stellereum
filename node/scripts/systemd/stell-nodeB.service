[Unit]
Description=Stellereum node B (shard 1, RPC 127.0.0.1:8546, P2P UDP 9411)
Documentation=file:/root/stellereum/scripts/backup/BACKUP.md
Wants=network-online.target
After=network-online.target
# Crash-loop guard: more than 5 restarts in 5 minutes means something is
# structurally wrong (bad genesis, corrupt data, bad binary). Stop retrying
# instead of melting the disk with restarts and journal spam; the operator
# investigates with `journalctl -u stell-nodeB -e` and `systemctl reset-failed`.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# The node lives under /root (node dir, mode-600 env file, keys). Stay root
# rather than adding a User= that cannot read its own key material.
User=root
Group=root
# Must match the live invocation (verified via /proc/PID/cwd): relative
# ./data, ./keys and --config node.yaml all resolve from here.
WorkingDirectory=/root/nodeB
# No leading "-" on purpose: a missing env file must FAIL the unit instead of
# starting the node with wrong ports / missing STELL_RPC_AUTH_TOKEN.
EnvironmentFile=/root/env.B
# Args mirror the exact live cmdline: run --config node.yaml --shard 1.
ExecStart=/root/stellereum/target/release/stellereum run --config node.yaml --shard 1
# The problem this file exists for: survive ssh drops and crashes.
Restart=always
# 5s lets the sled lock on ./data/store/db and the RPC/P2P ports release
# before the next attempt, without hammering the disk in a tight loop.
RestartSec=5
# Observed RSS is ~27 MB per node; 2G is ~70x headroom. A cap (not a
# reservation) so both nodes can coexist on the current 3.8 GB box, and it
# stops a runaway node from OOM-killing its sibling. Raise towards 3-4G only
# if a real 10 GB host shows sustained growth near the cap.
MemoryMax=2G
# The live box has 1 vCPU: 80% per node lets either burst while keeping sshd
# and journald responsive under a busy loop. On a multi-CPU host this can go
# to 100-200%.
CPUQuota=80%
# Kill the ever-growing run.log/current.log pattern (58 MB live.log seen in
# /root/nodeA): stdout/stderr go to the journal, which rotates and rate-limits.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stell-nodeB
# Cheap isolation that cannot break the node (it only uses ./data, ./keys).
PrivateTmp=true

[Install]
WantedBy=multi-user.target
