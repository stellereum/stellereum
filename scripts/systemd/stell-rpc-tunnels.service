[Unit]
Description=Stellereum RPC load-balancer reverse SSH tunnels (nodeA:8551->B, nodeA:8552->D)
Documentation=file:/home/imm/stellereum-project/scripts/rpc-lb-tunnels.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs from mainserver (which holds SSH keys + local node B on 127.0.0.1:8546)
# and opens reverse tunnels to node A so node A never holds private SSH keys.
ExecStart=/bin/sh /home/imm/stellereum-project/scripts/rpc-lb-tunnels.sh --reverse
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stell-rpc-tunnels

[Install]
WantedBy=default.target
